# Base URL of the NestJS backend the BFF proxies to (server-only, no NEXT_PUBLIC_).
# Kept off the client bundle on purpose — only the Next.js server reads it.
BACKEND_API_URL=https://bravachain-api-production.up.railway.app

# PTAX reference quotes feature flags (all default false / OFF)
NEXT_PUBLIC_FEATURE_COTACOES=false
NEXT_PUBLIC_FEATURE_COTACOES_CHART=false
NEXT_PUBLIC_FEATURE_COTACOES_CALCULADORA=false
NEXT_PUBLIC_FEATURE_COTACOES_ALERTAS=false

# Empresa screen feature flags (all default false / OFF)
NEXT_PUBLIC_FEATURE_EMPRESA=false
NEXT_PUBLIC_FEATURE_EMPRESA_PEP=false
